{
  "expo": {
    "name": "SnapMemory",
    "slug": "SnapMemory",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "snapmemory",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gemercik.snapmemory"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gemercik.snapmemory"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-image",
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "SnapMemory butuh akses kamera untuk mengambil foto memory."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SnapMemory butuh akses galeri untuk memilih foto."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "SnapMemory butuh akses galeri.",
          "savePhotosPermission": "SnapMemory butuh izin untuk menyimpan foto."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6C63FF"
        }
      ]
    ]
  }
}
